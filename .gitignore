.env
data/repos/
__pycache__/
*.pyc
# Per-phase run artifacts are regenerable via scripts/run_all.py, so raw
# per-paper JSON/txt dev logs aren't committed. Two exceptions ship anyway:
# outputs/trajectories/ (micro1 required deliverable #4) and each phase's
# FINAL_REPORT.md (the human-readable report -- a real deliverable, not a
# debug artifact, and judges shouldn't have to run the pipeline just to see
# what the output looks like).
outputs/*/*
!outputs/*/FINAL_REPORT.md
!outputs/trajectories/*
.venv/
*.egg-info/
.DS_Store
.claude/

# Working/prep material kept locally, not part of the submission: the
# competition brief (organizer's material, not ours to redistribute), the
# raw build instructions, internal scratch notes, our own self-audit, and
# video prep notes. The polished, submission-facing versions of anything
# useful from these live in README.md / REPRODUCTION.md / phases/*.md.
instructions.md
problem.md
MICRO1_JUDGE_AUDIT.txt
VIDEO.md
micro1 - First Hackathon*.pdf
